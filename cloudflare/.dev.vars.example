# 本地开发变量。复制为 .dev.vars 后再修改。
ALLOW_DEV_AUTH=true
# 仅本地演示支付；生产 wrangler.jsonc 必须保持 disabled。
PAYMENT_MODE=mock
WECHAT_PAY_ENABLED=false
CORS_ORIGIN=*
INSTITUTION_NAME=纯粹艺术文化
SESSION_SECRET=replace-with-a-long-random-string
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ADMIN_PASSWORD=ZhiXing@Admin2026
# 以下字段仅在本地联调真实微信支付时填写，演示支付不需要。
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://example.com/api/payments/wechat/notify
WECHAT_PAY_PLATFORM_CERT_SERIAL=
WECHAT_PAY_PLATFORM_CERT_PEM=
