PORT=3000
CORS_ORIGIN=*
NODE_ENV=development

# 后台会话签名密钥；生产环境必须替换为强随机值。
SESSION_SECRET=replace-with-a-long-random-secret
# 仅本地联调用；生产环境务必设为 false。
ALLOW_DEV_AUTH=true
# 本地联调使用 mock；生产保持 disabled，真实微信支付接入后再切换为 wechat。
PAYMENT_MODE=mock
WECHAT_PAY_ENABLED=false

# MySQL（docker compose -p art-studio up -d 后可用）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=art_studio_app
DB_PASSWORD=change-me-local-only
DB_NAME=art_studio
# Set a unique password before running npm run db:seed.
ADMIN_PASSWORD=replace-with-a-unique-local-admin-password

# Turso/libSQL（仅运行 scripts/migrate-turso.js 时使用）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare R2；留空时使用 backend/uploads 本地存储
R2_ACCOUNT_ID=
R2_BUCKET=mini-app-picture
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 微信小程序登录（生产必填；留空时开发模式用 devOpenid 登录种子账号）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
