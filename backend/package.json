{
  "name": "art-studio-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "knex --knexfile knexfile.js migrate:latest",
    "db:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "db:seed": "node src/seed.js",
    "db:migrate:turso": "node scripts/migrate-turso.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@libsql/client": "^0.17.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.3",
    "knex": "^3.1.0",
    "mysql2": "^3.12.0"
  }
}
