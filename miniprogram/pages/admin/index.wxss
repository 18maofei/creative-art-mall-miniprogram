.admin-head { display: flex; flex-direction: column; gap: 10rpx; padding: 40rpx 28rpx 34rpx; background: #e7f4ee; color: #164938; }.eyebrow { font-size: 20rpx; color: #397461; letter-spacing: 2rpx; }.title { font-size: 44rpx; font-weight: 700; }.copy { font-size: 25rpx; color: #4f7567; }.stat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }.stat-card { display: flex; flex-direction: column; gap: 8rpx; padding: 24rpx; border: 1rpx solid #e3ebe7; border-radius: 8rpx; background: #fff; }.stat-value { color: #18785c; font-size: 42rpx; font-weight: 700; }.list-card { overflow: hidden; }.student-row { display: flex; align-items: center; gap: 15rpx; padding: 21rpx 22rpx; border-bottom: 1rpx solid #edf1ef; }.student-row:last-child { border-bottom: 0; }.initial { display: flex; width: 62rpx; height: 62rpx; align-items: center; justify-content: center; border-radius: 50%; background: #f8e7d8; color: #a05216; font-size: 27rpx; font-weight: 700; }.student-main { display: flex; flex: 1; flex-direction: column; gap: 6rpx; }.student-name, .class-name { display: block; font-size: 28rpx; font-weight: 600; }.lesson-count, .capacity { display: flex; flex-direction: column; align-items: flex-end; color: #18785c; font-size: 26rpx; font-weight: 700; }.lesson-count text:last-child, .capacity text:last-child { color: #7a8a84; font-size: 20rpx; font-weight: 400; }.class-item { display: flex; justify-content: space-between; gap: 18rpx; margin-bottom: 14rpx; padding: 23rpx; border: 1rpx solid #e3ebe7; border-radius: 8rpx; background: #fff; }.class-item .muted { display: block; margin-top: 7rpx; }.empty { padding: 28rpx; color: #87948f; text-align: center; }
.admin-action { padding-bottom: 28rpx; }
.admin-tools { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:14rpx; }
.tool-card { position:relative; display:flex; min-width:0; min-height:132rpx; box-sizing:border-box; flex-direction:column; justify-content:center; gap:8rpx; padding:18rpx 42rpx 18rpx 20rpx; }
.tool-title { color:#214b3e; font-size:27rpx; font-weight:600; }
.tool-card .muted { font-size:21rpx; line-height:1.45; }
.tool-card .action-arrow { position:absolute; top:12rpx; right:14rpx; color:#18785c; font-size:36rpx; }
