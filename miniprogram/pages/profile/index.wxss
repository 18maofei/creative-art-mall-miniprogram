.profile-head { display: flex; align-items: center; gap: 18rpx; padding: 45rpx 28rpx; background: #fff; }.avatar { display: flex; width: 90rpx; height: 90rpx; align-items: center; justify-content: center; border-radius: 50%; background: #e7f4ee; color: #18785c; font-size: 35rpx; font-weight: 700; }.name { display: block; margin-bottom: 8rpx; font-size: 33rpx; font-weight: 700; }.profile-tip { display: flex; flex-direction: column; gap: 15rpx; padding: 25rpx; }.profile-tip .primary-btn { margin-top: 7rpx; }.service { display: flex; justify-content: space-between; padding: 27rpx 24rpx; border-bottom: 1rpx solid #edf1ef; font-size: 28rpx; }.service:last-child { border-bottom: 0; }.arrow { color: #8b9994; font-size: 36rpx; }
