<view class="page"><view class="section"><view class="card form"><text class="section-title">新增商品草稿</text><input placeholder="商品名称" value="{{name}}" data-field="name" bindinput="onInput"/><button class="primary-btn" bindtap="addProduct">创建商品</button></view></view><view class="section"><text class="section-title">选择 SKU 调整库存</text><view class="choice {{selectedSkuId == item.sku_id ? 'active' : ''}}" wx:for="{{products}}" wx:key="sku_id" data-id="{{item.sku_id}}" bindtap="selectSku">{{item.product_name}} · {{item.sku_name}} · 库存 {{item.stock_quantity}}</view><view class="card form"><input placeholder="数量，正数入库/负数出库" type="number" value="{{quantity}}" data-field="quantity" bindinput="onInput"/><input placeholder="调整原因" value="{{reason}}" data-field="reason" bindinput="onInput"/><button class="primary-btn" bindtap="changeStock">确认库存调整</button></view></view></view>
