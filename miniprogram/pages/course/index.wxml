<view class="page"><view class="page-head"><text class="page-title">课程报名</text><text class="muted">找到适合孩子的艺术课程</text></view><view class="tabs"><text class="tab active">全部课程</text><text class="tab">艺术启蒙</text><text class="tab">创作进阶</text></view><view class="section"><view class="course-card card" wx:for="{{courses}}" wx:key="id"><view class="large-art {{item.color}}"><view class="art-mark"></view></view><view class="course-body"><view><text class="course-title">{{item.name}}</text><text class="tag">适合 {{item.age}}</text></view><text class="muted">{{item.lessons}}次课 · {{item.schedule}}</text><text class="course-desc">{{item.description}}</text><view class="buy-row"><text class="price">¥{{item.price}}</text><button class="primary-btn small" data-index="{{index}}" bindtap="buy">立即购课</button></view></view></view></view></view>
