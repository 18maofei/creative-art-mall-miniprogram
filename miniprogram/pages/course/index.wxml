<view class="page"><view class="page-head"><text class="page-title">课程报名</text></view><view class="tabs"><text class="tab {{selected==='ALL'?'active':''}}" data-type="ALL" bindtap="filter">全部课程</text><text class="tab {{selected==='INTRO'?'active':''}}" data-type="INTRO" bindtap="filter">艺术启蒙</text><text class="tab {{selected==='ADVANCED'?'active':''}}" data-type="ADVANCED" bindtap="filter">创作进阶</text></view><view class="section"><view class="course-card card" wx:for="{{courses}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="course-body"><text class="course-title">{{item.name}}</text><text class="muted">{{item.lessons}} 次课 · {{item.age}}</text><text class="course-desc">{{item.description}}</text><text class="price">¥{{item.price}}</text></view></view></view></view>
