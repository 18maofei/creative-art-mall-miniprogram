.page-head { padding: 32rpx 28rpx 26rpx; background: #fff; }.page-title { display: block; margin-bottom: 8rpx; font-size: 40rpx; font-weight: 700; }.tabs { display: flex; gap: 14rpx; padding: 20rpx 28rpx; background: #fff; border-top: 1rpx solid #edf1ef; }.tab { flex: 1; padding: 13rpx 4rpx; border: 1rpx solid #dfe7e3; border-radius: 8rpx; text-align: center; color: #62716c; font-size: 24rpx; }.tab.active { border-color: #18785c; background: #e7f4ee; color: #18785c; }.course-card { display: flex; margin-bottom: 18rpx; overflow: hidden; }.large-art { width: 190rpx; min-height: 255rpx; flex: 0 0 auto; }.art-mark { width: 80rpx; height: 80rpx; margin: 45rpx auto; border: 14rpx solid rgba(255,255,255,.7); border-radius: 50%; }.course-body { display: flex; flex: 1; flex-direction: column; gap: 13rpx; padding: 22rpx; }.course-title { display: block; margin-bottom: 10rpx; font-size: 29rpx; font-weight: 700; }.course-desc { color: #53635d; font-size: 23rpx; line-height: 1.6; }.buy-row { display: flex; justify-content: space-between; align-items: center; margin-top: auto; }.small { padding: 13rpx 17rpx; font-size: 23rpx; }
