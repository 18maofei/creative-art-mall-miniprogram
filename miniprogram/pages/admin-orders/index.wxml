<view class="page"><view class="section"><view class="order" wx:for="{{orders}}" wx:key="id"><view><text class="order-no">{{item.order_no}}</text><text class="muted">{{item.buyer_name}} · ¥{{item.total_amount}}</text><text class="muted">{{item.shipping_address_snapshot || '未填写地址'}}</text></view><view class="order-side"><text>{{item.status}}</text><button wx:if="{{item.status === 'PENDING_PAYMENT' || item.status === 'PAID' || item.status === 'SHIPPED'}}" class="outline-btn" data-order="{{item}}" bindtap="nextStatus">推进状态</button></view></view><view wx:if="{{!orders.length}}" class="empty">暂无订单</view></view></view>
