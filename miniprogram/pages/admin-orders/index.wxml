<view class="page"><view class="section"><page-state loading="{{loading && !orders.length}}" error="{{loadError}}" empty="{{!loading && !loadError && !orders.length}}" empty-text="暂无订单" bind:retry="loadOrders"/><view class="order" wx:for="{{orders}}" wx:key="id"><view class="order-info"><text class="order-no">{{item.order_no}}</text><text class="muted">{{item.buyer_name}} · ¥{{item.total_amount}}</text><text class="muted">{{item.shipping_address_snapshot || '未填写地址'}}</text><text wx:if="{{item.tracking_no}}" class="muted">物流单号：{{item.tracking_no}}</text><text wx:if="{{item.refund_status}}" class="muted">退款：{{item.refund_status}}</text><text wx:if="{{item.payment_channel}}" class="muted">支付渠道：{{item.payment_channel}}</text></view><view class="order-side"><text>{{item.status}}</text><button wx:if="{{canManualPay && item.status === 'PENDING_PAYMENT'}}" class="outline-btn" data-order="{{item}}" bindtap="nextStatus">确认模拟支付</button><button wx:if="{{item.status === 'PAID' && item.type !== 'COURSE'}}" class="outline-btn" data-order="{{item}}" bindtap="beginShipping">登记发货</button><button wx:if="{{item.refundSupported && (item.status === 'PAID' || item.status === 'SHIPPED' || item.status === 'COMPLETED') && item.refund_status !== 'PROCESSING' && item.refund_status !== 'SUCCESS'}}" class="outline-btn refund-btn" data-order="{{item}}" bindtap="refund">申请退款</button></view><view wx:if="{{shippingOrderId == item.id}}" class="shipping-form"><input placeholder="填写真实物流单号" value="{{trackingNo}}" bindinput="onTrackingInput"/><button class="primary-btn" bindtap="ship">确认发货</button></view></view></view></view>
