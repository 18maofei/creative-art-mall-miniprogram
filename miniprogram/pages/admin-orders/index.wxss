.order { display:flex; justify-content:space-between; gap:16rpx; margin-bottom:14rpx; padding:23rpx; border:1rpx solid #e3ebe7; border-radius:8rpx; background:#fff; }.order-no,.muted { display:block; }.order-no { font-size:27rpx; font-weight:600; }.muted { margin-top:7rpx; color:#718078; font-size:22rpx; }.order-side { display:flex; flex-direction:column; align-items:flex-end; gap:14rpx; color:#18785c; font-size:23rpx; }.empty { padding:60rpx 0; color:#87948f; text-align:center; }
