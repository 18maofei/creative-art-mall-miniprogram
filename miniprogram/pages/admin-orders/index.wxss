.order { display:flex; flex-wrap:wrap; justify-content:space-between; gap:16rpx; margin-bottom:14rpx; padding:23rpx; border:1rpx solid #e3ebe7; border-radius:8rpx; background:#fff; }.order-info { min-width:0; flex:1; }.order-no,.muted { display:block; }.order-no { font-size:27rpx; font-weight:600; }.muted { margin-top:7rpx; color:#718078; font-size:22rpx; }.order-side { display:flex; flex-direction:column; align-items:flex-end; gap:14rpx; color:#18785c; font-size:23rpx; }.shipping-form { width:100%; display:flex; align-items:center; gap:12rpx; }.shipping-form input { min-width:0; flex:1; height:68rpx; padding:0 14rpx; border:1rpx solid #dfe7e3; border-radius:6rpx; font-size:24rpx; }.shipping-form button { width:220rpx; margin:0; }.refund-btn { color:#a33b36; border-color:#e8b8b5; }.empty { padding:60rpx 0; color:#87948f; text-align:center; }
.order-no, .order-info .muted { word-break:break-all; }
