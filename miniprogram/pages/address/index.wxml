<view class="page"><view class="section"><view class="address" wx:for="{{addresses}}" wx:key="id"><text>{{item.recipient_name}} {{item.mobile}}</text><text class="muted">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text></view></view><view class="section"><view class="card form"><input placeholder="收件人" data-field="recipientName" bindinput="onInput"/><input placeholder="手机号" type="number" data-field="mobile" bindinput="onInput"/><input placeholder="省" data-field="province" bindinput="onInput"/><input placeholder="市" data-field="city" bindinput="onInput"/><input placeholder="区/县" data-field="district" bindinput="onInput"/><input placeholder="详细地址" data-field="detail" bindinput="onInput"/><button class="primary-btn" bindtap="submit">保存为默认地址</button></view></view></view>
