.favorites-page { min-height: 100vh; box-sizing: border-box; padding: 34rpx 28rpx 150rpx; background: #f3f6f3; }
.favorites-intro { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 28rpx; }
.eyebrow { color: #8a9b91; font-size: 20rpx; letter-spacing: 2rpx; }
.title { color: #173f34; font-size: 44rpx; font-weight: 700; line-height: 1.18; }
.copy { color: #78877f; font-size: 24rpx; }
.favorites-list { display: flex; flex-direction: column; gap: 16rpx; }
.favorite-card { display: flex; min-height: 150rpx; align-items: center; gap: 18rpx; padding: 16rpx; border: 1rpx solid #ebe6da; border-radius: 12rpx; background: #fffdfa; box-shadow: 0 10rpx 26rpx rgba(58, 71, 58, .05); }
.favorite-image { width: 118rpx; height: 118rpx; flex: 0 0 auto; border-radius: 9rpx; background: #d9e3d6; }
.favorite-placeholder { display: flex; align-items: center; justify-content: center; background: #dae7de; color: #1d5b4a; font-size: 35rpx; font-weight: 700; }
.favorite-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 7rpx; }
.favorite-kind { color: #387b66; font-size: 20rpx; }
.favorite-title { overflow: hidden; color: #1d382f; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 700; }
.favorite-subtitle { display: -webkit-box; overflow: hidden; color: #819088; font-size: 21rpx; line-height: 1.4; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.remove-button { flex: 0 0 auto; margin: 0; padding: 8rpx 12rpx; border: 0; background: transparent; color: #7d8b83; font-size: 21rpx; line-height: 1.25; }
.remove-button::after { border: 0; }
.empty-state { display: flex; min-height: 360rpx; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; color: #66766f; font-size: 27rpx; text-align: center; }
.empty-icon { color: #1b6a56; font-size: 58rpx; line-height: 1; }
.empty-copy { color: #99a39d; font-size: 22rpx; }
@import "../../styles/customer.wxss";
