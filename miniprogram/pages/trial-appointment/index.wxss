.trial-page { padding-bottom:60rpx; }
.trial-hero { display:flex; flex-direction:column; gap:12rpx; padding:54rpx 42rpx 42rpx; background:#e7f4ee; }
.eyebrow { color:#4f796b; font-size:23rpx; }
.hero-title { color:#214438; font-size:48rpx; font-weight:700; }
.hero-copy { max-width:620rpx; color:#5e7c71; font-size:25rpx; line-height:1.6; }
.form-card { padding:28rpx; }
.form-title { color:#20332d; font-size:31rpx; font-weight:700; }
.child-title { margin-top:32rpx; }
.field { display:flex; align-items:center; min-height:86rpx; gap:20rpx; border-bottom:1rpx solid #edf1ef; }
.field > text:first-child { width:138rpx; flex-shrink:0; color:#52655d; font-size:26rpx; }
.field input { flex:1; min-width:0; height:76rpx; color:#20332d; font-size:26rpx; }
.field picker { flex:1; min-width:0; }
.picker-value { display:flex; align-items:center; justify-content:space-between; min-height:76rpx; color:#20332d; font-size:26rpx; }
.picker-value text { color:#24664f; font-size:38rpx; line-height:1; }
.field-column { display:flex; flex-direction:column; align-items:stretch; gap:10rpx; padding:18rpx 0; }
.field-column > text:first-child { width:auto; }
.field-column textarea { width:100%; min-height:140rpx; box-sizing:border-box; padding:16rpx; border:1rpx solid #dfe7e3; border-radius:8rpx; color:#20332d; font-size:25rpx; }
.submit-btn { width:100%; margin-top:28rpx; }
.privacy-tip { display:block; margin-top:18rpx; color:#94a09b; font-size:21rpx; line-height:1.5; text-align:center; }
@import "../../styles/customer.wxss";
