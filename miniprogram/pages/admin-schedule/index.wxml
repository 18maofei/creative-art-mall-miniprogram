<view class="page"><view class="section"><view class="card form"><text class="section-title">新增课程</text><input placeholder="课程名称" value="{{courseName}}" data-field="courseName" bindinput="onInput"/><input placeholder="课时数" type="number" value="{{lessonCount}}" data-field="lessonCount" bindinput="onInput"/><input placeholder="价格" type="digit" value="{{price}}" data-field="price" bindinput="onInput"/><button class="primary-btn" bindtap="addCourse">保存课程</button></view></view><view class="section"><text class="section-title">选择课程创建班级</text><view class="choice {{selectedCourseId == item.id ? 'active' : ''}}" wx:for="{{courses}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCourse">{{item.name}} · {{item.default_lesson_count}} 次</view><view class="card form"><input placeholder="班级名称" value="{{className}}" data-field="className" bindinput="onInput"/><button class="primary-btn" bindtap="addClass">创建班级</button></view></view><view class="section"><text class="section-title">选择班级新增课次</text><view class="choice {{selectedClassId == item.id ? 'active' : ''}}" wx:for="{{classes}}" wx:key="id" data-id="{{item.id}}" bindtap="selectClass">{{item.name}}</view><view class="card form"><input placeholder="第几次课" type="number" value="{{sequenceNo}}" data-field="sequenceNo" bindinput="onInput"/><input placeholder="开始时间，例如 2026-08-01 10:00:00" value="{{startsAt}}" data-field="startsAt" bindinput="onInput"/><input placeholder="结束时间，例如 2026-08-01 11:30:00" value="{{endsAt}}" data-field="endsAt" bindinput="onInput"/><button class="primary-btn" bindtap="addSession">新增课次</button></view></view></view>
