.teacher-banner { margin: 28rpx; padding: 30rpx; border-radius: 16rpx; background: #e4f0f5; }.banner-label { color: #396781; font-size: 23rpx; }.banner-title { display: block; margin: 13rpx 0; color: #214655; font-size: 36rpx; font-weight: 700; }.banner-copy { color: #52717f; font-size: 23rpx; }.student { display: flex; align-items: center; gap: 12rpx; padding: 21rpx; border-bottom: 1rpx solid #edf1ef; }.student:last-child { border-bottom: 0; }.avatar { display: flex; width: 66rpx; height: 66rpx; align-items: center; justify-content: center; border-radius: 50%; background: #e7f4ee; color: #18785c; font-size: 26rpx; font-weight: 700; }.student-info { display: flex; flex: 1; flex-direction: column; gap: 5rpx; }.student-name { font-size: 27rpx; font-weight: 600; }.state-btn { padding: 11rpx 13rpx; border: 1rpx solid #dfe7e3; border-radius: 7rpx; background: #fff; color: #5b6a66; font-size: 22rpx; }.state-btn.selected { border-color: #18785c; background: #e7f4ee; color: #18785c; font-weight: 700; }.state-btn.leave.selected { border-color: #d87522; background: #fff1e2; color: #a05216; }.rule { display: flex; flex-direction: column; gap: 12rpx; margin-top: 22rpx; padding: 22rpx; background: #f8faf9; }.confirm { width: 100%; margin-top: 22rpx; }.confirm[disabled] { background: #a5b9b1; }
