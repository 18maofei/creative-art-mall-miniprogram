.role-page { padding-bottom:150rpx; }.notice-list { display:flex; flex-direction:column; gap:10rpx; }.notice { display:flex; align-items:flex-start; gap:12rpx; padding:16rpx 20rpx; border-radius:12rpx; background:#fff7ec; }.notice-tag { flex-shrink:0; padding:2rpx 12rpx; border-radius:999rpx; background:#d87522; color:#fff; font-size:20rpx; }.notice-text { color:#7a5a34; font-size:22rpx; line-height:1.5; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }.feedback-mask { position:fixed; z-index:20; top:0; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:center; background:rgba(20,35,30,.45); }.feedback-modal { display:flex; width:620rpx; flex-direction:column; gap:16rpx; padding:32rpx; border-radius:16rpx; background:#fff; }.modal-title { font-size:30rpx; font-weight:700; color:#20332d; }.feedback-modal textarea { width:100%; height:170rpx; padding:16rpx; box-sizing:border-box; border:1rpx solid #dfe7e3; border-radius:8rpx; font-size:24rpx; }.feedback-modal textarea.short { height:100rpx; }.modal-actions { display:flex; gap:16rpx; }.modal-actions button { flex:1; margin:0; }.primary-btn { border:none; border-radius:999rpx; background:#16785c; color:#fff; font-size:25rpx; }.outline-btn { border:1rpx solid #cfe0d8; border-radius:999rpx; background:#fff; color:#33443e; font-size:25rpx; }.muted { color:#788781; font-size:22rpx; }.role-strip { display:flex; justify-content:space-between; margin:18rpx 28rpx 0; color:#55756a; font-size:23rpx; }.role-hero { display:flex; flex-direction:column; gap:12rpx; margin:20rpx 28rpx 0; padding:32rpx; border-radius:16rpx; background:#e4f0f5; }.hero-label { color:#396781; font-size:23rpx; }.hero-title { color:#214655; font-size:40rpx; font-weight:700; }.hero-sub { color:#52717f; font-size:23rpx; line-height:1.5; }.role-hero button { align-self:flex-start; border-radius:8rpx; background:#18785c; color:#fff; font-size:24rpx; }.quick-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14rpx; }.quick-item { padding:18rpx 4rpx 14rpx; border-radius:12rpx; background:#fff; text-align:center; color:#42544d; font-size:21rpx; }.quick-icon { display:flex; width:58rpx; height:58rpx; align-items:center; justify-content:center; margin:0 auto 10rpx; border-radius:50%; color:#fff; font-weight:700; }.green { background:#5aa38a; }.orange { background:#de914c; }.blue { background:#548aa9; }.purple { background:#9f7abb; }.todo-card { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:14rpx; padding:22rpx; }.todo-card view { display:flex; flex:1; flex-direction:column; gap:7rpx; }.grow { display:flex; min-width:0; flex:1; flex-direction:column; gap:7rpx; }.row-title { font-size:27rpx; font-weight:600; }.student { display:flex; align-items:center; gap:12rpx; padding:21rpx; border-bottom:1rpx solid #edf1ef; }.student:last-child { border-bottom:0; }.avatar { display:flex; width:66rpx; height:66rpx; align-items:center; justify-content:center; border-radius:50%; background:#e7f4ee; color:#18785c; font-size:26rpx; font-weight:700; }.state-btn { padding:11rpx 13rpx; border:1rpx solid #dfe7e3; border-radius:7rpx; background:#fff; color:#5b6a66; font-size:22rpx; }.state-btn.selected { border-color:#18785c; background:#e7f4ee; color:#18785c; font-weight:700; }.state-btn.leave.selected { border-color:#d87522; background:#fff1e2; color:#a05216; }.empty-line { padding:34rpx; color:#75847f; text-align:center; }.bottom-banner { display:flex; align-items:center; justify-content:space-between; padding:23rpx 25rpx; border-radius:12rpx; color:#18785c; font-size:25rpx; }.bottom-banner view { display:flex; flex-direction:column; gap:7rpx; }.teacher-banner { background:#e4f0f5; }.banner-title { font-size:28rpx; font-weight:700; }.banner-copy { color:#5b7d70; font-size:22rpx; }.custom-nav { position:fixed; z-index:10; right:0; bottom:0; left:0; display:flex; height:112rpx; align-items:center; justify-content:space-around; border-top:1rpx solid #ebf0ed; background:rgba(255,255,255,.98); }.nav-item { display:flex; min-width:100rpx; flex-direction:column; align-items:center; gap:5rpx; color:#7d8985; font-size:20rpx; }.nav-item text:first-child { font-size:31rpx; }.nav-item.active { color:#18785c; }
