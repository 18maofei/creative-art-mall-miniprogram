<view class="page"><view class="section"><text class="section-title">选择学生</text><view class="choice {{childId == item.id ? 'active' : ''}}" wx:for="{{children}}" wx:key="id" data-id="{{item.id}}" bindtap="selectChild">{{item.name}} · 剩余 {{item.remaining_lessons}} 次</view></view><view class="section"><text class="section-title">选择班级</text><view class="choice {{classId == item.id ? 'active' : ''}}" wx:for="{{classes}}" wx:key="id" data-id="{{item.id}}" bindtap="selectClass">{{item.name}} · {{item.enrolled_count}}/{{item.capacity}}</view></view><view class="section"><button class="primary-btn" bindtap="submit">确认报名</button></view></view>
