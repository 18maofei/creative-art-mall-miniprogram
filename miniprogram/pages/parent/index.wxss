.role-page { padding-bottom:150rpx; }.notice-list { display:flex; flex-direction:column; gap:10rpx; }.notice { display:flex; align-items:flex-start; gap:12rpx; padding:16rpx 20rpx; border-radius:12rpx; background:#fff7ec; }.notice-tag { flex-shrink:0; padding:2rpx 12rpx; border-radius:999rpx; background:#d87522; color:#fff; font-size:20rpx; }.notice-text { color:#7a5a34; font-size:22rpx; line-height:1.5; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }.feedback-item { display:flex; flex-direction:column; gap:6rpx; padding:14rpx 0; border-bottom:1rpx solid #e8efeb; }.feedback-item:last-child { border-bottom:0; }.role-strip { display:flex; justify-content:space-between; margin:18rpx 28rpx 0; color:#55756a; font-size:23rpx; }.role-hero { display:flex; flex-direction:column; gap:12rpx; margin:20rpx 28rpx 0; padding:32rpx; border-radius:16rpx; background:#e7f4ee; }.hero-label { color:#477263; font-size:23rpx; }.hero-title { color:#214438; font-size:40rpx; font-weight:700; }.hero-sub { color:#527267; font-size:23rpx; line-height:1.5; }.role-hero button { align-self:flex-start; border-radius:8rpx; background:#24664f; color:#fff; font-size:24rpx; }.quick-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14rpx; }.quick-item { padding:18rpx 4rpx 14rpx; border-radius:12rpx; background:#fff; text-align:center; color:#42544d; font-size:21rpx; }.quick-icon { display:flex; width:58rpx; height:58rpx; align-items:center; justify-content:center; margin:0 auto 10rpx; border-radius:50%; color:#fff; font-weight:700; }.green { background:#5aa38a; }.orange { background:#de914c; }.blue { background:#548aa9; }.purple { background:#9f7abb; }.account-card { display:flex; align-items:center; justify-content:space-between; padding:24rpx; }.account-card view { display:flex; flex-direction:column; gap:8rpx; }.account-number { color:#24664f; font-size:58rpx; font-weight:700; }.account-number text { font-size:26rpx; }.lesson-row { display:flex; align-items:center; gap:16rpx; padding:22rpx; border-bottom:1rpx solid #edf1ef; }.lesson-row:last-child { border-bottom:0; }.date-box { display:flex; width:70rpx; height:70rpx; flex-direction:column; align-items:center; justify-content:center; border-radius:9rpx; background:#fff1e2; color:#a05216; font-size:21rpx; font-weight:700; }.grow { display:flex; min-width:0; flex:1; flex-direction:column; gap:7rpx; }.row-title { font-size:27rpx; font-weight:600; }.arrow { color:#24664f; font-size:38rpx; }.empty-line { padding:34rpx; color:#75847f; text-align:center; }.feedback-card { display:flex; flex-direction:column; gap:14rpx; padding:24rpx; border-radius:14rpx; background:#f4f8f6; }.bottom-banner { display:flex; align-items:center; justify-content:space-between; padding:23rpx 25rpx; border-radius:12rpx; color:#24664f; font-size:25rpx; }.bottom-banner view { display:flex; flex-direction:column; gap:7rpx; }.parent-banner { background:#e7f4ee; }.banner-title { font-size:28rpx; font-weight:700; }.banner-copy { color:#5b7d70; font-size:22rpx; }.custom-nav { position:fixed; z-index:10; right:0; bottom:0; left:0; display:flex; height:112rpx; align-items:center; justify-content:space-around; border-top:1rpx solid #ebf0ed; background:rgba(255,255,255,.98); }.nav-item { display:flex; min-width:100rpx; flex-direction:column; align-items:center; gap:5rpx; color:#7d8985; font-size:20rpx; }.nav-item text:first-child { font-size:31rpx; }.nav-item.active { color:#24664f; }
