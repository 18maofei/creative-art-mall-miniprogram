.parent-banner { margin: 28rpx; padding: 30rpx; border-radius: 16rpx; background: #e7f4ee; }.banner-label { color: #497466; font-size: 23rpx; }.banner-title { display: block; margin: 13rpx 0; font-size: 36rpx; font-weight: 700; }.banner-copy { color: #527267; font-size: 23rpx; }.balance { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; }.balance view { display: flex; flex-direction: column; gap: 7rpx; }.remaining { color: #18785c; font-size: 64rpx; font-weight: 700; }.remaining-unit { margin-left: 7rpx; font-size: 26rpx; }.lesson { display: flex; align-items: center; gap: 17rpx; padding: 22rpx; border-bottom: 1rpx solid #edf1ef; }.lesson:last-child { border-bottom: 0; }.date { display: flex; width: 75rpx; height: 75rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 9rpx; background: #fff1e2; color: #a05216; font-size: 21rpx; font-weight: 700; }.lesson-info { display: flex; flex: 1; flex-direction: column; gap: 7rpx; }.lesson-title { font-size: 26rpx; font-weight: 600; }.tiny { padding: 11rpx 14rpx; font-size: 22rpx; }.feedback { display: flex; flex-direction: column; gap: 14rpx; padding: 24rpx; background: #e7f4ee; }.feedback-copy { color: #477263; font-size: 25rpx; line-height: 1.65; }
