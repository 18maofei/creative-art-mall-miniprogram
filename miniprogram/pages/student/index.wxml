<view class="page student-page"><view class="student-hero"><text class="eyebrow">拾色画室 · 学生端</text><text class="hero-title">你好，{{userName}}</text><text class="hero-copy">把每一次创作都留在自己的成长档案里。</text><button class="primary-btn" bindtap="goCourse">浏览课程</button></view><view class="section"><view class="section-head"><text class="section-title">推荐课程</text><text class="section-link" bindtap="goCourse">全部课程 ›</text></view><view class="card course-list"><view class="course-row" wx:for="{{courses}}" wx:key="id" data-id="{{item.id}}" bindtap="openCourse"><view class="course-cover" style="background-image:url('{{item.cover_url}}')"></view><view class="grow"><text class="row-title">{{item.name}}</text><text class="muted">{{item.age}} · {{item.lessons}} 次课</text></view><text class="arrow">›</text></view><view wx:if="{{!courses.length && !loading}}" class="empty-line">暂时没有可展示的课程</view></view></view><view class="section"><view class="section-head"><text class="section-title">课堂作品</text><text class="section-link" bindtap="goGallery">查看全部 ›</text></view><view class="art-grid"><view class="art-card" wx:for="{{artworks}}" wx:key="id" data-id="{{item.id}}" bindtap="goGallery"><image src="{{item.image_url}}" mode="aspectFill"></image><text>{{item.title || '未命名作品'}}</text></view></view><view wx:if="{{!artworks.length && !loading}}" class="card empty-line">老师发布作品后会在这里展示</view></view><view class="custom-nav"><view class="nav-item active" bindtap="goCourse"><text>▣</text><text>课程</text></view><view class="nav-item" bindtap="goGallery"><text>▤</text><text>作品</text></view><view class="nav-item" bindtap="goProfile"><text>◉</text><text>我的</text></view></view></view>
