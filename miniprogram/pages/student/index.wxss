.student-page { padding-bottom: 110rpx; }.student-hero { display:flex; flex-direction:column; gap:16rpx; margin:28rpx; padding:36rpx 32rpx; border-radius:22rpx; color:#fff; background:linear-gradient(135deg,#276c61,#3b9d8a); box-shadow:0 12rpx 28rpx rgba(39,108,97,.2); }.eyebrow { font-size:23rpx; opacity:.82; }.hero-title { font-size:46rpx; font-weight:700; }.hero-copy { font-size:25rpx; line-height:1.6; opacity:.9; }.student-hero .primary-btn { align-self:flex-start; color:#276c61; background:#fff; padding:15rpx 24rpx; }.course-list { padding:0 24rpx; }.course-row { display:flex; align-items:center; gap:18rpx; min-height:126rpx; border-bottom:1rpx solid #eef2ef; }.course-row:last-child { border-bottom:0; }.course-cover { width:126rpx; height:84rpx; border-radius:10rpx; background:#e3eee9 center/cover; }.grow { flex:1; min-width:0; }.row-title { display:block; font-size:29rpx; font-weight:600; margin-bottom:8rpx; }.arrow { color:#7a8c86; font-size:40rpx; }.art-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18rpx; }.art-card { overflow:hidden; border-radius:14rpx; background:#fff; box-shadow:0 8rpx 22rpx rgba(33,68,56,.06); }.art-card image { display:block; width:100%; height:260rpx; background:#e7eee9; }.art-card text { display:block; padding:15rpx; font-size:25rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.empty-line { padding:28rpx 24rpx; color:#75847f; text-align:center; }.custom-nav { position:fixed; left:0; right:0; bottom:0; z-index:5; display:flex; justify-content:space-around; padding:14rpx 0 calc(14rpx + env(safe-area-inset-bottom)); background:#fff; box-shadow:0 -4rpx 16rpx rgba(30,61,49,.08); }.nav-item { display:flex; flex-direction:column; align-items:center; gap:5rpx; color:#83918c; font-size:22rpx; }.nav-item text:first-child { font-size:31rpx; }.nav-item.active { color:#18785c; }
