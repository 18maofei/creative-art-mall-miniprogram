.gallery-page { padding-bottom: 80rpx; }
.gallery-head { display: flex; flex-direction: column; padding: 24rpx 28rpx 18rpx; background: #fff; }
.gallery-eyebrow { color: #24664f; font-size: 20rpx; font-weight: 600; }
.gallery-title { margin-top: 8rpx; color: #183d34; font-size: 42rpx; font-weight: 700; line-height: 1.2; }
.gallery-section { margin-top: 16rpx; }
.gallery-list { display: flex; flex-direction: column; gap: 16rpx; }
.gallery-card { overflow: hidden; border: 1rpx solid #e3ebe7; border-radius: 16rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(31, 75, 61, .06); }
.gallery-card-hover { background: #f8fcfa; opacity: .96; }
.gallery-media { position: relative; display: flex; height: 300rpx; align-items: center; justify-content: center; overflow: hidden; background: #edf5f1; }
.gallery-art { width: 100%; height: 100%; }
.gallery-placeholder { position: relative; display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; overflow: hidden; background: #dcece4; color: #6d8b7e; font-size: 22rpx; }
.placeholder-shape { position: absolute; border: 18rpx solid rgba(19, 134, 110, .18); border-radius: 50%; }
.placeholder-shape-one { width: 190rpx; height: 190rpx; top: -55rpx; right: 28rpx; }
.placeholder-shape-two { width: 135rpx; height: 135rpx; bottom: -48rpx; left: 50rpx; border-color: rgba(240, 120, 22, .18); }
.media-tag { position: absolute; top: 16rpx; left: 16rpx; padding: 6rpx 12rpx; border-radius: 999rpx; background: rgba(19, 75, 61, .84); color: #fff; font-size: 20rpx; }
.gallery-info { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 18rpx 20rpx 20rpx; }
.gallery-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 9rpx; }
.gallery-title-text { overflow: hidden; color: #22463b; text-overflow: ellipsis; white-space: nowrap; font-size: 29rpx; font-weight: 700; }
.gallery-meta { display: flex; align-items: center; gap: 8rpx; }
.meta-label { color: #9aa9a3; font-size: 21rpx; }
.meta-value { overflow: hidden; color: #71827b; text-overflow: ellipsis; white-space: nowrap; font-size: 23rpx; }
.gallery-favorite { display: flex; width: 64rpx; height: 64rpx; flex: 0 0 auto; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; border-radius: 50%; background: #f3f8f5; color: #6f887c; }
.gallery-favorite::after { border: 0; }
.favorite-icon { font-size: 38rpx; line-height: 1; }
.gallery-favorite.is-favorite { background: #e2f2eb; color: #1a8063; }
.favorite-hover { opacity: .7; transform: scale(.95); }
.state-card { display: flex; min-height: 280rpx; box-sizing: border-box; align-items: center; justify-content: center; padding: 42rpx 30rpx; border: 1rpx solid #e3ebe7; border-radius: 16rpx; background: #fff; flex-direction: column; text-align: center; box-shadow: 0 8rpx 22rpx rgba(31, 75, 61, .05); }
.loading-mark { width: 48rpx; height: 48rpx; margin-bottom: 18rpx; border: 5rpx solid #dcece4; border-top-color: #24664f; border-radius: 50%; }
.state-icon { display: flex; width: 56rpx; height: 56rpx; align-items: center; justify-content: center; margin-bottom: 15rpx; border-radius: 50%; background: #fff0dd; color: #d77822; font-size: 32rpx; font-weight: 700; }
.empty-icon { background: #e5f2eb; color: #24664f; font-size: 27rpx; }
.state-title { color: #27493f; font-size: 28rpx; font-weight: 700; }
.state-copy { margin-top: 8rpx; color: #87968f; font-size: 23rpx; }
.retry-button { min-width: 180rpx; margin-top: 22rpx; padding: 13rpx 24rpx; border-radius: 999rpx; background: #24664f; color: #fff; font-size: 24rpx; line-height: 1.2; }
@import "../../styles/customer.wxss";
