<view class="page"><view class="section"><view class="card form"><text class="section-title">新增学员</text><input placeholder="学员姓名" value="{{childName}}" data-field="childName" bindinput="onInput"/><button class="primary-btn" bindtap="addChild">新增学员</button></view></view><view class="section"><text class="section-title">选择学员</text><view class="choice {{selectedChildId == item.id ? 'active' : ''}}" wx:for="{{children}}" wx:key="id" data-id="{{item.id}}" bindtap="selectChild">{{item.name}} · 剩余 {{item.remaining_lessons}} 次</view></view><view class="section"><view class="card form"><text class="section-title">课时调整</text><input placeholder="调整次数，正数增加/负数减少" type="number" value="{{quantity}}" data-field="quantity" bindinput="onInput"/><input placeholder="调整原因" value="{{reason}}" data-field="reason" bindinput="onInput"/><button class="primary-btn" bindtap="changeLessons">确认调整</button></view></view></view>
