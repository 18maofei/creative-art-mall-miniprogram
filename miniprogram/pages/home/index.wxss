.hero { position: relative; overflow: hidden; height: 330rpx; margin: 28rpx; padding: 34rpx; border-radius: 16rpx; background: #dcecdf; }
.eyebrow { position: relative; color: #396854; font-size: 22rpx; }.hero-title { position: relative; margin-top: 10rpx; color: #20332d; font-size: 46rpx; font-weight: 700; line-height: 1.12; }.hero-copy { position: relative; margin-top: 12rpx; color: #496658; font-size: 23rpx; line-height: 1.55; }.hero-btn { position: relative; margin: 17rpx 0 0; padding: 12rpx 20rpx; border-radius: 8rpx; background: #18785c; color: #fff; font-size: 23rpx; }.hero-art { position: absolute; }.hero-ring { right: -50rpx; bottom: -120rpx; width: 310rpx; height: 310rpx; border: 45rpx solid #f5cb7c; border-radius: 50%; }.hero-mountain { right: 48rpx; bottom: 49rpx; width: 155rpx; height: 90rpx; background: #63a78d; clip-path: polygon(0 100%, 45% 15%, 68% 65%, 100% 0, 100% 100%); }
.quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }.quick-item { padding: 18rpx 4rpx 14rpx; border-radius: 12rpx; background: #fff; text-align: center; color: #42544d; font-size: 21rpx; }.quick-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin: 0 auto 10rpx; border-radius: 50%; color: #fff; font-weight: 700; }.green { background: #5aa38a; }.orange { background: #de914c; }.blue { background: #548aa9; }.purple { background: #9f7abb; }
.art-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 14rpx; height: 250rpx; }.art-card { position: relative; overflow: hidden; border-radius: 12rpx; }.art-card text { position: absolute; left: 18rpx; bottom: 16rpx; color: #fff; font-size: 25rpx; font-weight: 600; }.ochre { background: #e8c78d; }.teal { background: #85b9b2; }.circle { position: absolute; right: 28rpx; top: 30rpx; width: 110rpx; height: 110rpx; border: 17rpx solid rgba(255,255,255,.75); border-radius: 50%; }.square { position: absolute; right: 30rpx; top: 42rpx; width: 85rpx; height: 85rpx; border: 15rpx solid rgba(255,255,255,.75); border-radius: 8rpx; transform: rotate(18deg); }
.course-preview { display: flex; align-items: center; gap: 18rpx; margin-bottom: 14rpx; padding: 16rpx; }.course-image { width: 110rpx; height: 90rpx; border-radius: 9rpx; flex: 0 0 auto; }.sand { background: #e8c78d; }.blue { background: #8bb8c1; }.pink { background: #e4aaa0; }.course-info { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 8rpx; }.course-name { font-size: 27rpx; font-weight: 600; }.go-arrow { color: #18785c; font-size: 42rpx; }.profile-link { width: 100%; border-radius: 10rpx; background: #e7f4ee; color: #18785c; font-size: 26rpx; }
