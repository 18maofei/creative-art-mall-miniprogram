.identity-page { min-height:100vh; }.identity-hero { display:flex; flex-direction:column; gap:14rpx; padding:52rpx 42rpx 44rpx; background:#e7f4ee; }.eyebrow { color:#497466; font-size:24rpx; }.title { color:#20332d; font-size:46rpx; font-weight:700; }.copy { color:#58756b; font-size:25rpx; line-height:1.6; }.role-card,.visitor-card { display:flex; align-items:center; gap:20rpx; margin-bottom:16rpx; padding:24rpx; }.role-icon { display:flex; width:76rpx; height:76rpx; align-items:center; justify-content:center; border-radius:50%; color:#fff; font-size:29rpx; font-weight:700; }.visitor { background:#5aa38a; }.parent { background:#548aa9; }.teacher { background:#9f7abb; }.student { background:#3f9b9a; }.operator { background:#b27c43; }.admin { background:#d87522; }.role-copy { display:flex; flex:1; flex-direction:column; gap:8rpx; }.role-title { font-size:29rpx; font-weight:700; }.selected { color:#18785c; font-size:24rpx; }.arrow { color:#7a8c86; font-size:40rpx; }.loading-card { color:#58756b; text-align:center; padding:34rpx 24rpx; }
