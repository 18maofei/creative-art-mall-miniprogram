<view class="page identity-page"><view class="identity-hero"><text class="eyebrow">拾色画室 · 安全身份中心</text><text class="title">{{singleRole ? '当前服务身份' : '选择服务身份'}}</text><text class="copy">身份和权限由画室后台配置。这里只显示当前账号已被授权的身份。</text></view><view wx:if="{{loading}}" class="section loading"><view class="card loading-card">正在从服务端验证账号...</view></view><view wx:elif="{{loggedIn && roles.length}}" class="section"><view class="card role-card" wx:for="{{roles}}" wx:key="id" data-role="{{item.id}}" bindtap="select"><view class="role-icon {{item.style}}">{{item.icon}}</view><view class="role-copy"><text class="role-title">{{item.title}}</text><text class="muted">{{item.desc}}</text></view><text wx:if="{{current === item.id}}" class="selected">✓ 当前</text><text wx:else class="arrow">›</text></view></view><view wx:else class="section"><view class="card visitor-card" data-role="visitor" bindtap="select"><view class="role-icon visitor">访</view><view class="role-copy"><text class="role-title">访客浏览</text><text class="muted">登录后才会显示可用服务身份</text></view><text class="arrow">›</text></view></view></view>
