.cart-glyph { position: relative; width: 44rpx; height: 44rpx; }
.cart-glyph-handle { position: absolute; top: 7rpx; left: 2rpx; width: 11rpx; height: 11rpx; border-top: 4rpx solid #fff; border-left: 4rpx solid #fff; transform: skew(-14deg); }
.cart-glyph-basket { position: absolute; top: 11rpx; left: 11rpx; width: 27rpx; height: 19rpx; box-sizing: border-box; border: 4rpx solid #fff; border-top: 0; border-radius: 0 0 6rpx 6rpx; transform: skew(-8deg); }
