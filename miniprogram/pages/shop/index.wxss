.cart-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 40; display: flex; align-items: flex-end; background: rgba(20, 47, 39, .28); }
.cart-sheet { width: 100%; max-height: 70vh; box-sizing: border-box; padding: 24rpx 28rpx 30rpx; border-radius: 26rpx 26rpx 0 0; background: #fff; box-shadow: 0 -10rpx 30rpx rgba(20, 47, 39, .12); }
