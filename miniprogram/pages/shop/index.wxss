.page-head { padding: 32rpx 28rpx 26rpx; background: #fff; }.page-title { display: block; margin-bottom: 8rpx; font-size: 40rpx; font-weight: 700; }.shop-card { display: flex; gap: 20rpx; margin-bottom: 16rpx; padding: 18rpx; }.product-art { display: flex; align-items: center; justify-content: center; width: 155rpx; height: 140rpx; border-radius: 10rpx; }.product-shape { width: 72rpx; height: 72rpx; border: 12rpx solid rgba(255,255,255,.75); border-radius: 10rpx; transform: rotate(18deg); }.product-info { display: flex; min-width: 0; flex: 1; flex-direction: column; justify-content: space-around; }.product-name { font-size: 29rpx; font-weight: 700; }.buy-row { display: flex; justify-content: space-between; align-items: center; }.cart-bar { position: fixed; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; padding: 18rpx 28rpx; background: #fff; box-shadow: 0 -5rpx 18rpx rgba(21, 50, 40, .09); font-size: 26rpx; }.cart-bar .primary-btn { padding: 14rpx 30rpx; }
