<view class="page"><view class="page-head"><text class="page-title">周边商城</text><text class="muted">给孩子的创作好伙伴</text></view><view class="section"><view class="shop-card card" wx:for="{{products}}" wx:key="id"><view class="product-art {{item.color}}"><view class="product-shape"></view></view><view class="product-info"><text class="product-name">{{item.name}}</text><text class="muted">{{item.desc}}</text><view class="buy-row"><text class="price">¥{{item.price}}</text><button class="outline-btn" data-index="{{index}}" bindtap="add">加入购物车</button></view></view></view></view><view class="cart-bar"><text>购物车 {{cartCount}} 件</text><button class="primary-btn" bindtap="checkout">去结算</button></view></view>
