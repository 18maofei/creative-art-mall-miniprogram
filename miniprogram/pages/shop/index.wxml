<view class="page shop-page">
  <view class="shop-head">
    <text class="page-title">周边商城</text>
    <view class="shop-search"><text class="search-icon">⌕</text><input class="search-input" value="{{keyword}}" placeholder="搜索画材、手工材料..." bindinput="search" /></view>
  </view>
  <view class="section shop-section">
    <view class="section-head"><text class="section-title">精选材料</text><text class="muted">给创作更多可能</text></view>
    <view class="shop-card card" wx:for="{{products}}" wx:key="id">
      <view class="product-media"><image wx:if="{{item.cover_url}}" class="product-image" src="{{item.cover_url}}" mode="aspectFill"/><view wx:else class="product-art product-{{index}}"><view class="product-shape"></view></view></view>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-category">{{item.category || '创作材料'}}</text>
        <text class="muted product-desc">{{item.desc}}</text>
        <view class="buy-row"><text class="price">¥{{item.price}}</text><button class="outline-btn" data-index="{{index}}" bindtap="add"><text class="button-plus">＋</text>加入购物车</button></view>
      </view>
    </view>
    <page-state loading="{{loading}}" error="{{loadError}}" empty="{{!products.length}}" empty-text="{{keyword ? '没有找到匹配的商品，换个关键词试试' : '暂无在售商品'}}" bind:retry="loadData" />
  </view>
  <view class="floating-cart" bindtap="toggleCart" aria-label="打开购物车">
    <view class="cart-glyph">
      <view class="cart-glyph-handle"></view>
      <view class="cart-glyph-basket"></view>
      <view class="cart-wheel cart-wheel-one"></view>
      <view class="cart-wheel cart-wheel-two"></view>
    </view>
    <text wx:if="{{cartCount}}" class="cart-badge">{{cartCount}}</text>
  </view>

  <view wx:if="{{cartVisible}}" class="cart-overlay" catchtap="closeCart">
    <view class="cart-sheet" catchtap="stopCartTap">
      <view class="cart-sheet-head">
        <view class="cart-title"><text>购物车</text><text class="muted">{{cartCount}} 件 · ¥{{cartTotal}}</text></view>
        <button class="cart-sheet-close" catchtap="closeCart">×</button>
      </view>
      <view wx:if="{{cart.length}}" class="cart-sheet-list">
        <view wx:for="{{cart}}" wx:key="id" class="cart-row">
          <view class="cart-main"><text class="product-name">{{item.name}}</text><text class="price">¥{{item.price}}</text></view>
          <view class="quantity"><button class="qty-btn" data-index="{{index}}" data-delta="-1" bindtap="changeQuantity">−</button><text>{{item.quantity}}</text><button class="qty-btn" data-index="{{index}}" data-delta="1" bindtap="changeQuantity">＋</button></view>
        </view>
        <button class="primary-btn" bindtap="checkout" loading="{{checking}}" disabled="{{checking}}">{{paymentEnabled ? '去结算 · ¥' + cartTotal : '查看购买说明'}}</button>
      </view>
      <view wx:else class="cart-sheet-empty">购物车还是空的，先挑一件喜欢的周边吧。</view>
    </view>
  </view>
</view>
