<view class="page"><view class="section"><text class="section-title">选择孩子</text><view class="choice {{selectedChildId == item.id ? 'active' : ''}}" wx:for="{{children}}" wx:key="id" data-id="{{item.id}}" bindtap="selectChild">{{item.name}}</view></view><view class="section"><view class="card form"><text class="section-title">新建并绑定家长</text><input placeholder="家长姓名" value="{{parentName}}" data-field="parentName" bindinput="onInput"/><input placeholder="手机号（可选）" type="number" value="{{mobile}}" data-field="mobile" bindinput="onInput"/><input placeholder="关系，例如 母亲/父亲" value="{{relationship}}" data-field="relationship" bindinput="onInput"/><button class="primary-btn" bindtap="submit">创建并绑定</button></view></view></view>
