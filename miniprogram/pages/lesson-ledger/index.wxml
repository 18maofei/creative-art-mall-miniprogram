<view class="page ledger-page">
  <view class="state-wrap"><page-state loading="{{loading}}" error="{{loadError}}" bind:retry="loadData" /></view>
  <view class="ledger-head"><text class="head-title">课时账户</text><text class="head-copy">每次充值、赠送、上课扣减都会留下记录</text></view>
  <view class="section">
    <view class="card child-picker" wx:if="{{students.length}}"><text>查看孩子</text><picker mode="selector" range="{{studentOptions}}" value="{{selectedIndex}}" disabled="{{loading}}" bindchange="onStudentChange"><view class="picker-value">{{studentOptions[selectedIndex]}}<text>›</text></view></picker></view>
    <view wx:if="{{selectedChildId}}" class="balance-card"><view><text class="muted">{{students[selectedIndex].name}} 当前剩余</text><text class="balance">{{students[selectedIndex].remainingLessons || 0}}<text> 次</text></text></view><text class="balance-tip">以最新流水余额为准</text></view>
    <view wx:if="{{!loading && !loadError && students.length && !entries.length}}" class="empty-card">暂无课时流水</view>
    <view wx:else class="ledger-list">
      <view class="card ledger-row" wx:for="{{entries}}" wx:key="id">
        <view class="ledger-main"><text class="ledger-type">{{item.typeLabel}}</text><text class="ledger-reason">{{item.reason}}</text><text class="ledger-time">{{item.created_at}}</text></view>
        <view class="ledger-side"><text class="quantity {{item.quantityClass}}">{{item.quantityText}}</text><text class="after">余额 {{item.balance_after}} 次</text></view>
      </view>
    </view>
    <view wx:if="{{!students.length && !loading && !loadError}}" class="empty-card">暂未绑定学员，请联系画室前台</view>
  </view>
</view>
