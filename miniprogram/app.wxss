page { background: #f3f6f3; color: #183d34; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
button { margin: 0; line-height: normal; }
button::after { border: 0; }
.page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.section { margin: 28rpx 28rpx 0; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #183d34; }
.section-link { color: #24664f; font-size: 25rpx; }
.card { background: #ffffff; border-radius: 28rpx; box-shadow: 0 9rpx 25rpx rgba(31, 75, 61, .07); }
.muted { color: #71827b; font-size: 25rpx; }
.primary-btn { border-radius: 999rpx; background: #24664f; color: #fff; font-size: 27rpx; font-weight: 600; padding: 18rpx 24rpx; }
.outline-btn { border: 1rpx solid #24664f; border-radius: 999rpx; background: #fff; color: #24664f; font-size: 25rpx; padding: 14rpx 20rpx; }
.price { color: #f07816; font-size: 30rpx; font-weight: 700; }
.tag { display: inline-block; padding: 5rpx 12rpx; border-radius: 999rpx; background: #e4f3ec; color: #24664f; font-size: 22rpx; }
